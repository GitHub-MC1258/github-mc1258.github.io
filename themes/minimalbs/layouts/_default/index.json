{{- $index := slice -}}
{{- range (where .Site.RegularPages "Params.searchable" "ne" false) -}}
    {{- if ne .Layout "search" -}}
        {{- $rawDate := .PublishDate | default .Date -}}
        {{- $formattedDate := "Date inconnue" -}}
        {{- with $rawDate -}}{{- $formattedDate = .Format "02/01/2006" -}}{{- end -}}

        {{- /* On garde .Plain pour la recherche exhaustive, mais on évite le double nettoyage */ -}}
        {{- $cleanContent := .Plain | htmlUnescape -}}

        {{- $entry := dict
            "title" .Title
            "author" (.Params.author | default $.Site.Params.author)
            "date" $formattedDate
            "content" $cleanContent
            "permalink" .Permalink
        -}}
        {{- $index = $index | append $entry -}}
    {{- end -}}
{{- end -}}
{{- $index | jsonify -}}
