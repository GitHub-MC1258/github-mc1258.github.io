<div class="pswp-gallery row" id="gallery-{{ .Ordinal }}">

  {{/* ---------------------------------------------------------
       CAPTIONS
  --------------------------------------------------------- */}}
  {{ $captions := dict }}

  {{ with .Page.Resources.GetMatch .Page.Params.captions }}
    {{ $captions = . | transform.Unmarshal }}
  {{ end }}

  {{/* ---------------------------------------------------------
       IMAGES UNIQUEMENT (IMPORTANT FIX)
  --------------------------------------------------------- */}}
  {{ $images := where .Page.Resources "MediaType.MainType" "image" }}

  {{ range $images }}
    {{ $img := . }}

    {{/* safety check (optionnel mais robuste) */}}
    {{ if $img.MediaType.SubType }}

      {{ $thumb := $img.Fit "400x400" }}
      {{ $caption := index $captions $img.Name }}

      <div class="col-6 col-md-4 mb-4">
        <a href="{{ $img.RelPermalink }}"
           data-pswp-width="{{ $img.Width }}"
           data-pswp-height="{{ $img.Height }}"
           data-caption="{{ $caption | default "" }}">

          <img src="{{ $thumb.RelPermalink }}"
               class="img-fluid rounded shadow-sm"
               loading="lazy"
               alt="{{ $caption | default $img.Name }}">

          {{ if $caption }}
            <div class="text-muted small text-center mt-2">
              {{ $caption }}
            </div>
          {{ end }}

        </a>
      </div>

    {{ end }}
  {{ end }}

</div>
